{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/products",
      "destination": "/parts",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/reviews",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/services/",
      "permanent": false
    },
    {
      "source": "/laptop-service-center-in/koramangala",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/marathahalli",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/electronic-city",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/indiranagar",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/banashankari",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/btm-layout",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/hsr-layout",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/jayanagar",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/rajajinagar",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/yelahanka",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/bellandur",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/sarjapur",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/hebbal",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/kr-puram",
      "destination": "/pickup-areas/",
      "permanent": true
    },
    {
      "source": "/laptop-service-center-in/mahadevapura",
      "destination": "/pickup-areas/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
